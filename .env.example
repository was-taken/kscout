# Copy to .env for local use, or set these in your host's dashboard.
# Never commit a real token.

# Your VEX Events API token (https://events.vex.com/api/v2 -> Request Access).
# Locally you can leave this empty and paste the token in Settings instead.
ROBOTEVENTS_TOKEN=

# Set to 1 when hosting: accepts outside connections, locks the token, protects notes.
PUBLIC_SITE=

# Optional: shared team notes, readable and editable only after signing in with this.
# Use at least 10 characters. Without it, each visitor's notes stay in their browser.
TEAM_PASSWORD=

# Optional: folder on a persistent disk for shared notes (e.g. /var/data).
DATA_DIR=

# Optional tuning
# PORT=5173
# CACHE_MINUTES=15
# API_REQS_PER_MIN=600
